{
  "openapi": "3.1.1",
  "info": { "title": "pw-dev control-plane API", "version": "1.0.0", "description": "Progressive API catalog. Load a linked domain document only when it is needed." },
  "servers": [{ "url": "/" }],
  "paths": {
    "/_pwdev/status": { "get": { "operationId": "getPwDevStatus", "summary": "Check server and broker health", "responses": { "200": { "description": "Live status" } } } },
    "/_pwdev/env": { "get": { "operationId": "getPwDevEnvironment", "summary": "Discover live runtime paths and settings", "responses": { "200": { "description": "Runtime environment details" } } } },
    "/_pwdev/instructions": { "get": { "operationId": "getPwDevInstructions", "summary": "Read the live agent workflow guide", "responses": { "200": { "description": "Machine-readable operating instructions" } } } },
    "/_pwdev/delegates": { "get": { "operationId": "listPwDevDelegates", "summary": "Discover component-owned APIs", "responses": { "200": { "description": "Available delegated API catalogs" } } } }
  },
  "x-pwdev-documents": [
    { "id": "apps", "url": "/_pwdev/openapi/apps.json", "whenToUse": "List, register, or inspect apps." },
    { "id": "browserConfigs", "url": "/_pwdev/openapi/browser-configs.json", "whenToUse": "Create or inspect reusable Chrome launch configuration." },
    { "id": "browsers", "url": "/_pwdev/openapi/browsers.json", "whenToUse": "Create, reuse, start, stop, or destroy a browser." },
    { "id": "remoteBrokers", "url": "/_pwdev/openapi/remote-brokers.json", "whenToUse": "Provision a remote Linux broker over SSH and expose it through a server-owned local forward." },
    { "id": "sshAssets", "url": "/_pwdev/openapi/ssh-assets.json", "whenToUse": "Manage remote hosts and redacted, server-stored SSH key assets." },
    { "id": "sessions", "url": "/_pwdev/openapi/sessions.json", "whenToUse": "Inspect or stop a live browser session." },
    { "id": "proxies", "url": "/_pwdev/openapi/proxies.json", "whenToUse": "Register proxy metadata or read captured proxy traffic." }
  ]
}
