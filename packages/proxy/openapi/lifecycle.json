{
  "openapi": "3.1.1",
  "info": {
    "title": "pw-dev managed proxy lifecycle API",
    "version": "1.0.0",
    "description": "Each in-house Whistle -S profile is a durable proxy definition and the source of truth. Process start and stop only change runtime state; DELETE removes the profile."
  },
  "servers": [{ "url": "/_proxy" }],
  "paths": {
    "/proxies": {
      "get": { "operationId": "listManagedProxies", "responses": { "200": { "description": "Durable managed proxy profiles and runtime state" } } },
      "post": { "operationId": "createManagedProxy", "responses": { "200": { "description": "Created a stopped durable managed proxy profile; browser start launches it on demand" } } }
    },
    "/proxies/{id}": {
      "get": {
        "operationId": "getManagedProxy",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Durable proxy profile and runtime state" } }
      },
      "delete": {
        "operationId": "deleteManagedProxy",
        "description": "Explicitly stop the process and permanently remove the Whistle profile.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Deleted managed proxy and profile" } }
      }
    },
    "/proxies/{id}/status": {
      "get": {
        "operationId": "getManagedProxyRuntimeStatus",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Whistle process status for one durable profile" } }
      }
    },
    "/proxies/{id}/rulesets": {
      "get": {
        "operationId": "listWhistleRulesets",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Whistle rulesets and selected state" } }
      }
    },
    "/proxies/{id}/rulesets/{name}/select": {
      "post": {
        "operationId": "selectWhistleRuleset",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Selected Whistle rulesets" } }
      }
    },
    "/proxies/{id}/rulesets/{name}/unselect": {
      "post": {
        "operationId": "unselectWhistleRuleset",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Selected Whistle rulesets" } }
      }
    },
    "/proxies/{id}/start": {
      "post": {
        "operationId": "startManagedProxy",
        "description": "Idempotently start Whistle from its saved profile.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Started or already-running proxy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StartedProxy" } } } } }
      }
    },
    "/proxies/{id}/stop": {
      "post": {
        "operationId": "stopManagedProxy",
        "description": "Stop Whistle without deleting configuration, rules, or traffic data.",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Stopped proxy with profile preserved" } }
      }
    },
    "/proxies/{id}/restart": {
      "post": {
        "operationId": "restartManagedProxy",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Restarted proxy from its durable profile" } }
      }
    },
    "/stop-all": {
      "post": {
        "operationId": "stopAllManagedProxies",
        "description": "Stop all Whistle processes while preserving every profile.",
        "responses": { "200": { "description": "Stopped proxies with profiles preserved" } }
      }
    }
  },
  "components": {
    "schemas": {
      "StartedProxy": {
        "type": "object",
        "required": ["ok", "proxy", "alreadyRunning"],
        "properties": {
          "ok": { "type": "boolean" },
          "proxy": { "type": "object", "required": ["id", "running"], "properties": { "id": { "type": "string" }, "running": { "type": "boolean" } } },
          "alreadyRunning": { "type": "boolean" }
        }
      }
    }
  }
}
